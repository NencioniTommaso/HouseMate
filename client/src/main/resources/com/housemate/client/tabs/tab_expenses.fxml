<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" styleClass="tab-container" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.housemate.client.controllers.tabs.TabExpensesController">

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <VBox>
            <Label text="Expenses" styleClass="tab-title" />
            <Label fx:id="lblOverview" text="This Month:" styleClass="card-label" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button styleClass="btn-add-primary" text="+ Add Expense" onAction="#handleAddExpense" />
    </HBox>

    <HBox spacing="10.0">
        <VBox alignment="CENTER" styleClass="display-panel" HBox.hgrow="ALWAYS" onMouseClicked="#handleOpenSettleDebts">
            <Label text="You Owe" styleClass="card-label" />
            <Label fx:id="lblAmountYouOwe" styleClass="negative-amount-large" />
        </VBox>

        <VBox alignment="CENTER" styleClass="display-panel" HBox.hgrow="ALWAYS" onMouseClicked="#handleOpenYouAreOwed">
            <Label text="You Are Owed" styleClass="card-label" />
            <Label fx:id="lblAmountYouAreOwed" styleClass="positive-amount-large" />
        </VBox>
    </HBox>

    <VBox fx:id="filtersPanel" spacing="10.0" styleClass="display-panel" alignment="CENTER_LEFT">
        <fx:define>
            <ToggleGroup fx:id="expenseSelectionGroup"/>
        </fx:define>

        <HBox spacing="10.0">
            <RadioButton styleClass="custom-radio-button"  fx:id="rdbDebtor" text="Debtor" toggleGroup="$expenseSelectionGroup" />
            <RadioButton styleClass="custom-radio-button"  fx:id="rdbCreditor" text="Creditor" toggleGroup="$expenseSelectionGroup" />
            <RadioButton styleClass="custom-radio-button"  text="All" toggleGroup="$expenseSelectionGroup" selected="true" />
        </HBox>

        <HBox spacing="10.0">
            <DatePicker styleClass="custom-date-picker" fx:id="dtpSearchDateStart" prefWidth="150.0" promptText="From..." />
            <DatePicker styleClass="custom-date-picker" fx:id="dtpSearchDateEnd" prefWidth="150.0" promptText="To..." />
        </HBox>

        <TextField styleClass="custom-text-field" fx:id="txtSearchExp" prefWidth="110.0" promptText="Description..." />

        <fx:define>
            <ToggleGroup fx:id="searchType"/>
        </fx:define>

        <HBox spacing="10.0">
            <RadioButton styleClass="custom-radio-button"  fx:id="rdbExpenses" text="Expenses" toggleGroup="$searchType" selected = "true"/>
            <RadioButton styleClass="custom-radio-button"  text="Settlements" toggleGroup="$searchType" />
        </HBox>
    </VBox>

    <HBox alignment="CENTER_LEFT">
        <Label text="Search Results" styleClass="chronology-label"><VBox.margin><Insets top="5.0" bottom="-5.0" /></VBox.margin></Label>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnShowFilters" styleClass="btn-cancel" text="Show Filters" visible="false" managed="false" onAction="#handleShowFilters"/>
        <Button fx:id="btnHideFilters" styleClass="btn-cancel" text="Hide Filters" onAction="#handleHideFilters"/>
    </HBox>
    <ScrollPane fitToWidth="true" vbarPolicy="NEVER" styleClass="transparent-scrollpane" VBox.vgrow="ALWAYS">
        <VBox fx:id="dataContainer" spacing="8.0"/>
    </ScrollPane>
</VBox>

