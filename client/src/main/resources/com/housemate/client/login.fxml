<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.Label ?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<BorderPane prefHeight="750.0" prefWidth="420.0" style="-fx-background-color: #F4F6F8;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.housemate.client.controllers.LoginController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="55.0" style="-fx-background-color: #2C3E50; -fx-padding: 10 20 10 20;" BorderPane.alignment="CENTER">
            <Label text="HouseMate" textFill="WHITE"><font><Font name="System Bold" size="18.0" /></font></Label>
            <Region HBox.hgrow="ALWAYS" />
        </HBox>
    </top>

    <center>

        <VBox maxWidth="250.0" alignment="CENTER" spacing="10.0" BorderPane.alignment="CENTER">
            <Label text="Sign in" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" />
            <Label text="Username:" style="-fx-font-size: 14px; -fx-text-fill: #2C3E50;" />
            <TextField fx:id="txtUsername" promptText="Enter your username" style="-fx-pref-width: 200px; -fx-padding: 5px;" />
            <Label text="Password:" style="-fx-font-size: 14px; -fx-text-fill: #2C3E50;" />
            <PasswordField fx:id="txtPassword" promptText="Enter your password" style="-fx-pref-width: 200px; -fx-padding: 5px;" />
            <Button fx:id="btnLogin"  onAction="#handleLogin" text="Login" style="-fx-background-color: #2C3E50; -fx-text-fill: white; -fx-font-size: 16px; -fx-cursor: hand; -fx-padding: 10px 20px;" />
            <CheckBox text ="Remember me" style="-fx-font-size: 12px; -fx-text-fill: #2C3E50;"/>

            <HBox alignment="CENTER" >
                <Label text="Don't have an account?" style="-fx-font-size: 12px; -fx-text-fill: #2C3E50;" />
                <Button fx:id="btnRegister" onAction="#handleRegister" text="Register" style="-fx-background-color: transparent; -fx-text-fill: #2980B9; -fx-font-size: 12px; -fx-cursor: hand;" />
            </HBox>
            <Label fx:id="loggingInLabel" text="Logging in:" visible="false" style="-fx-font-size: 14px; -fx-text-fill: #2C3E50;" />

        </VBox>
    </center>
</BorderPane>
