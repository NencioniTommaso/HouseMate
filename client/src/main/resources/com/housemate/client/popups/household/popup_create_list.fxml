<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.TextField?>

<?import javafx.scene.control.ScrollPane?>
<StackPane fx:id="popupCreateList" managed="false" visible="false" styleClass="popup-overlay" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.housemate.client.controllers.popups.household.PopupCreateListController">
    <Region styleClass="popup-background" />
    <VBox maxHeight="400.0" maxWidth="350.0" spacing="15.0" styleClass="popup-container">

        <HBox alignment="CENTER_LEFT">
            <Label text="New Shopping List" styleClass="popup-title"><font><Font name="System Bold" size="20.0" /></font></Label>
            <Region HBox.hgrow="ALWAYS" />
            <Button styleClass="btn-cancel" text="Back" onAction="#handleReturnToLists" />
            <Button styleClass="btn-cancel" text="X" onAction="#handlePopupClosing" />
        </HBox>

        <VBox spacing="10.0" VBox.vgrow="SOMETIMES">
            <VBox spacing="5.0">
                <Label text="List name:" styleClass="popup-label" />
                <TextField styleClass="custom-text-field" fx:id="txtListName" maxWidth="Infinity" promptText="Enter list name..." />
                <Label text="Add an item:" styleClass="popup-label" />
                <HBox alignment="CENTER_LEFT" VBox.vgrow="ALWAYS" spacing="10.0">
                    <TextField styleClass="custom-text-field" fx:id="txtAddItem" maxWidth="Infinity" promptText="Enter new item..." />
                    <Button styleClass="btn-add-primary" text="Add" onAction="#handleAddItem" alignment="CENTER"/>
                </HBox>
            </VBox>
        </VBox>

        <ScrollPane fitToWidth="true" styleClass="transparent-scrollpane" VBox.vgrow="ALWAYS" vbarPolicy="NEVER" >
            <VBox fx:id="itemListContainer" spacing="5.0"/>
        </ScrollPane>

        <HBox spacing="10.0">
            <Button maxWidth="Infinity" styleClass="btn-add-primary" text="Create" onAction="#handleListCreation"/>
            <Button maxWidth="Infinity" styleClass="btn-cancel" text="Cancel" onAction="#handlePopupClosing"/>
        </HBox>

    </VBox>
</StackPane>