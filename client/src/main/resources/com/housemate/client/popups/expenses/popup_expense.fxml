<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!-- Popup "Add Expense" -->
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.RadioButton?>
<StackPane fx:id="popupAddExpense" managed="false" visible="false" styleClass="popup-overlay" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.housemate.client.controllers.popups.expenses.PopupExpenseController">
    <Region styleClass="popup-background" />
    <VBox maxHeight="500.0" maxWidth="380.0" spacing="15.0" styleClass="popup-container">
        <HBox alignment="CENTER_LEFT">
            <Label text="Add Expense" styleClass="popup-title"><font><Font name="System Bold" size="20.0" /></font></Label>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnCloseAddExpense" styleClass="popup-close-button" text="X" />
        </HBox>

        <HBox spacing="15.0" VBox.vgrow="ALWAYS">
            <!-- Left side: Form fields -->
            <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                <VBox spacing="5.0">
                    <Label text="Description:" styleClass="popup-label" />
                    <TextField fx:id="txtExpenseDescription" maxWidth="Infinity" promptText="e.g., Grocery shopping..." />
                </VBox>

                <VBox spacing="5.0">
                    <Label text="Amount:" styleClass="popup-label" />
                    <TextField fx:id="txtExpenseAmount" maxWidth="Infinity" promptText="0.00" />
                </VBox>

                <VBox spacing="5.0">
                    <Label text="Split method:" styleClass="popup-label" />

                    <fx:define>
                        <ToggleGroup fx:id="splitMethodGroup" />
                    </fx:define>

                    <RadioButton text ="Equal Split" toggleGroup="$splitMethodGroup" selected="true" />
                    <RadioButton text ="Weighted Shares Split" toggleGroup="$splitMethodGroup" />
                    <RadioButton text ="Custom Split" toggleGroup="$splitMethodGroup" />
                    <RadioButton text = "Adjustment Split" toggleGroup="$splitMethodGroup" />
                </VBox>
            </VBox>
        </HBox>

        <ScrollPane vbarPolicy="NEVER" hbarPolicy="NEVER" fitToHeight="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 5 5 20 5; -fx-alignment: top-center;">

            <HBox fx:id="contenitoreUtenti" spacing="15.0" alignment="CENTER_LEFT">

                <VBox alignment="CENTER" spacing="5.0" maxHeight="10" style="-fx-background-color: #F8F9F9; -fx-padding: 10; -fx-background-radius: 5; -fx-border-color: #E5E7E9; -fx-border-radius: 5;">
                    <Label text="Marco" style="-fx-font-weight: bold; -fx-text-fill: #2C3E50;" />
                    <Label text="€ 0.00" style="-fx-font-weight: bold; -fx-text-fill: #44BB44;" />

                    <TextField text="€ 0.00" prefWidth="70.0" alignment="CENTER" />
                </VBox>

                <VBox alignment="CENTER" spacing="5.0" maxHeight="10" style="-fx-background-color: #F8F9F9; -fx-padding: 10; -fx-background-radius: 5; -fx-border-color: #E5E7E9; -fx-border-radius: 5;">
                    <Label text="Giulia" style="-fx-font-weight: bold; -fx-text-fill: #2C3E50;" />
                    <Label text="€ 0.00" style="-fx-font-weight: bold; -fx-text-fill: #44BB44;" />
                    <TextField text="€ 0.00" prefWidth="70.0" alignment="CENTER" />
                </VBox>

            </HBox>
        </ScrollPane>

        <HBox spacing="10.0">
            <Button fx:id="btnCreateExpense" maxWidth="Infinity" styleClass="btn-add-primary" text="Create" />
            <Button fx:id="btnCancelExpense" maxWidth="Infinity" styleClass="btn-cancel" text="Cancel" />
        </HBox>
    </VBox>
</StackPane>

