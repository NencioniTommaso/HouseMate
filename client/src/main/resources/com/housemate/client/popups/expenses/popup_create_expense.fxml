<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.RadioButton?>

<StackPane fx:id="popupCreateExpense" managed="false" visible="false" styleClass="popup-overlay" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.housemate.client.controllers.popups.expenses.PopupCreateExpenseController">
    <Region styleClass="popup-background" />
    <VBox maxHeight="550.0" maxWidth="380.0" spacing="15.0" styleClass="popup-container">

        <HBox alignment="CENTER_LEFT">
            <Label text="Add Expense" styleClass="popup-title"><font><Font name="System Bold" size="20.0" /></font></Label>
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#handlePopupClosing" styleClass="cancel-button" text="X"  />
        </HBox>

        <HBox spacing="15.0" VBox.vgrow="ALWAYS">
            <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                <VBox spacing="5.0">
                    <Label text="Description:" styleClass="standard-label" />
                    <TextField styleClass="custom-text-field" fx:id="txtExpenseDescription" maxWidth="Infinity" promptText="e.g., Grocery shopping..." />
                </VBox>

                <VBox spacing="5.0">
                    <Label text="Amount:" styleClass="standard-label" />
                    <TextField styleClass="custom-text-field" fx:id="txtExpenseAmount" maxWidth="Infinity" promptText="0.00" />
                </VBox>

                <VBox spacing="5.0">
                    <Label text="Split method:" styleClass="standard-label" />

                    <fx:define>
                        <ToggleGroup fx:id="splitMethodGroup" />
                    </fx:define>

                    <RadioButton styleClass="custom-radio-button"  fx:id="btnEqualSplit" text ="Equal Split" toggleGroup="$splitMethodGroup" selected="true" />
                    <RadioButton styleClass="custom-radio-button"  fx:id="btnSharesSplit" text ="Weighted Shares Split" toggleGroup="$splitMethodGroup" />
                    <RadioButton styleClass="custom-radio-button"  fx:id="btnCustomSplit" text ="Custom Split" toggleGroup="$splitMethodGroup" />
                    <RadioButton styleClass="custom-radio-button"  fx:id="btnAdjustmentSplit" text = "Adjustment Split" toggleGroup="$splitMethodGroup" />
                </VBox>
            </VBox>
        </HBox>

        <ScrollPane vbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="horizontal-carousel, transparent-scrollpane">
            <HBox fx:id="membersContainer" alignment="CENTER_LEFT"/>
        </ScrollPane>

        <HBox spacing="10.0">
            <Button onAction="#handleExpenseCreation" maxWidth="Infinity" styleClass="standard-button" text="Create" />
            <Button onAction="#handlePopupClosing" maxWidth="Infinity" styleClass="cancel-button" text="Cancel" />
        </HBox>

    </VBox>
</StackPane>

