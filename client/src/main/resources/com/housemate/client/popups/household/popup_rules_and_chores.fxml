<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!-- Popup "Regole e Chores" -->
<?import javafx.scene.control.ScrollPane?>
<StackPane fx:id="popupRulesAndChores" managed="false" visible="false" styleClass="popup-overlay" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <Region styleClass="popup-background" />
    <VBox maxHeight="500.0" maxWidth="350.0" spacing="15.0" styleClass="popup-container">
        <HBox alignment="CENTER_LEFT">
            <Label text="📋 Regole e Chores" styleClass="popup-title"><font><Font name="System Bold" size="20.0" /></font></Label>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnCloseRulesAndChores" styleClass="popup-close-button" text="X" />
        </HBox>

        <ScrollPane fitToWidth="true" styleClass="transparent-scrollpane" VBox.vgrow="ALWAYS" vbarPolicy="NEVER" >
            <content>
                <VBox spacing="10.0" style="-fx-padding: 0;">

                    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="chore-item">
                        <VBox HBox.hgrow="ALWAYS">
                            <Label text="Doing the dishes" styleClass="chore-title" />
                            <Label text="Frequency: Every day" styleClass="chore-detail" />
                        </VBox>
                        <VBox alignment="CENTER_RIGHT" spacing="5.0">
                            <Button styleClass="btn-delete" text="Delete" />
                        </VBox>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="chore-item">
                        <VBox HBox.hgrow="ALWAYS">
                            <Label text="Vacuuming the living room" styleClass="chore-title" />
                            <Label text="Frequency: Every 3 days" styleClass="chore-detail" />
                        </VBox>
                        <VBox alignment="CENTER_RIGHT" spacing="5.0">
                            <Button styleClass="btn-delete" text="Delete" />
                        </VBox>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="chore-item">
                        <VBox HBox.hgrow="ALWAYS">
                            <Label text="Taking out the trash" styleClass="chore-title" />
                            <Label text="Frequency: Every 2 days" styleClass="chore-detail" />
                        </VBox>
                        <VBox alignment="CENTER_RIGHT" spacing="5.0">
                            <Button styleClass="btn-delete" text="Delete" />
                        </VBox>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="chore-item">
                        <VBox HBox.hgrow="ALWAYS">
                            <Label text="Cleaning the bathroom" styleClass="chore-title" />
                            <Label text="Frequency: Every 7 days" styleClass="chore-detail" />
                        </VBox>
                        <VBox alignment="CENTER_RIGHT" spacing="5.0">
                            <Button styleClass="btn-delete" text="Delete" />
                        </VBox>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="chore-item">
                        <VBox HBox.hgrow="ALWAYS">
                            <Label text="Watering the plants" styleClass="chore-title" />
                            <Label text="Frequency: Every 4 days" styleClass="chore-detail" />
                        </VBox>
                        <VBox alignment="CENTER_RIGHT" spacing="5.0">
                            <Button styleClass="btn-delete" text="Delete" />
                        </VBox>
                    </HBox>



                </VBox>
            </content>
        </ScrollPane>


        <HBox spacing=" 10.0" alignment="BOTTOM_CENTER">
            <Button fx:id="btnCreateChore" maxWidth="Infinity" styleClass="btn-add-primary" text="+ Add New Chore" />
        </HBox>
    </VBox>
</StackPane>

