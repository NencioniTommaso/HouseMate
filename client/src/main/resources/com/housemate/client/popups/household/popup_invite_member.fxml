<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.TextArea?>

<StackPane fx:id="popupInviteMember" managed="false" visible="false" styleClass="popup-overlay" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.housemate.client.controllers.popups.household.PopupInviteMemberController">
    <Region styleClass="popup-background" />
    <VBox maxHeight="300.0" maxWidth="350.0" spacing="15.0" styleClass="popup-container">

        <HBox alignment="CENTER_LEFT">
            <Label text="Invite Member" styleClass="popup-title"><font><Font name="System Bold" size="20.0" /></font></Label>
            <Region HBox.hgrow="ALWAYS" />
            <Button styleClass="btn-cancel" text="X" onAction="#handlePopupClosing" />
        </HBox>

        <VBox spacing="5.0" alignment="CENTER" VBox.vgrow="ALWAYS">
            <Label text="Invitation Code:" styleClass="popup-title"/>
            <TextArea fx:id="lblInvitationCode" editable="false" focusTraversable="false" wrapText="true" styleClass="popup-title" />
        </VBox>

        <HBox alignment="BOTTOM_CENTER">
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnRefreshCode" styleClass="btn-add-primary" text="Refresh" onAction="#handleRefreshCode" />
        </HBox>

    </VBox>
</StackPane>

