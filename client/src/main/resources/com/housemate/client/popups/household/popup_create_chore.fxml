<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!-- Popup "Add Assignment" -->
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Spinner?>
<StackPane fx:id="popupCreateChore" managed="false" visible="false" styleClass="popup-overlay" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <Region styleClass="popup-background" />
    <VBox maxHeight="400.0" maxWidth="350.0" spacing="15.0" styleClass="popup-container">
        <HBox alignment="CENTER_LEFT">
            <Label text="Create New Chore" styleClass="popup-title"><font><Font name="System Bold" size="20.0" /></font></Label>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnReturn" styleClass="popup-close-button" text="Back" />
            <Button fx:id="btnCloseCreateChore" styleClass="popup-close-button" text="X" />
        </HBox>

        <VBox spacing="10.0" VBox.vgrow="ALWAYS">
            <VBox spacing="5.0">

                <Label text="Chore description:" styleClass="popup-label" />
                <TextField fx:id="txtChoreDesc" maxWidth="Infinity" promptText="Enter description..." />

                <Label text="Frequency in days: " styleClass="popup-label" />
                <Spinner fx:id="spnFrequencyDays" maxWidth="Infinity" />
            </VBox>


        </VBox>

        <HBox spacing="10.0">
            <Button fx:id="btnCreateAssignment" maxWidth="Infinity" styleClass="btn-add-primary" text="Create" />
            <Button fx:id="btnCancelAssignment" maxWidth="Infinity" styleClass="btn-cancel" text="Cancel" />
        </HBox>
    </VBox>
</StackPane>

