<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.control.ScrollPane?>
<StackPane fx:id="popupShoppingLists" managed="false" visible="false" styleClass="popup-overlay" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.housemate.client.controllers.popups.household.PopupShoppingListsController">
    <Region styleClass="popup-background" />
    <VBox maxHeight="500.0" maxWidth="350.0" spacing="15.0" styleClass="popup-container">

        <HBox alignment="CENTER_LEFT">
            <Label text="Shopping Lists" styleClass="popup-title"><font><Font name="System Bold" size="20.0" /></font></Label>
            <Region HBox.hgrow="ALWAYS" />
            <Button styleClass="cancel-button" text="X" onAction="#handlePopupClosing" />
        </HBox>

        <ScrollPane fitToWidth="true" styleClass="transparent-scrollpane" VBox.vgrow="ALWAYS" vbarPolicy="NEVER">
            <VBox fx:id="listsContainer"/>
        </ScrollPane>

        <HBox spacing=" 10.0" alignment="BOTTOM_CENTER">
            <Button onAction="#handleOpenCreateList" maxWidth="Infinity" styleClass="standard-button" text="+ New Shopping List" />
        </HBox>

    </VBox>
</StackPane>

