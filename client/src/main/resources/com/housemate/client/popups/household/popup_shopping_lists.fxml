<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!-- Popup "Impostazioni Casa" -->
<?import javafx.scene.control.ScrollPane?>
<StackPane fx:id="popupSettings" managed="false" visible="false" styleClass="popup-overlay" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <Region styleClass="popup-background" />
    <VBox maxHeight="500.0" maxWidth="350.0" spacing="15.0" styleClass="popup-container">
        <HBox alignment="CENTER_LEFT">
            <Label text="🛒 Shopping Lists" styleClass="popup-title"><font><Font name="System Bold" size="20.0" /></font></Label>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnCloseSettings" styleClass="btn-popup-close" text="X" />
        </HBox>

        <ScrollPane fitToWidth="true" styleClass="transparent-scrollpane" VBox.vgrow="ALWAYS" hbarPolicy="NEVER">

            <VBox spacing="10.0" style="-fx-padding: 2;">

                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="shopping-item">
                    <VBox HBox.hgrow="ALWAYS">
                        <Label text="Shopping List 1" styleClass="shopping-title" />
                        <Label text="02 Mar 2026" styleClass="shopping-date" />
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" alignment="CENTER_RIGHT">
                        <Label text="PENDING" styleClass="shopping-status"><font><Font name="System Bold" size="14.0" /></font></Label>
                        <Button styleClass="shopping-button" text="Details" />
                    </VBox>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="shopping-item">
                    <VBox HBox.hgrow="ALWAYS">
                        <Label text="Shopping List 2" styleClass="shopping-title" />
                        <Label text="02 Mar 2026" styleClass="shopping-date" />
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" alignment="CENTER_RIGHT">
                        <Label text="NOT STARTED" styleClass="shopping-status"><font><Font name="System Bold" size="14.0" /></font></Label>
                        <Button styleClass="shopping-button" text="Details" />
                    </VBox>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="shopping-item">
                    <VBox HBox.hgrow="ALWAYS">
                        <Label text="Shopping List 3" styleClass="shopping-title" />
                        <Label text="02 Mar 2026" styleClass="shopping-date" />
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" alignment="CENTER_RIGHT">
                        <Label text="COMPLETED" styleClass="shopping-status"><font><Font name="System Bold" size="14.0" /></font></Label>
                        <Button styleClass="shopping-button" text="Details" />
                    </VBox>
                </HBox>

            </VBox>



        </ScrollPane>
    </VBox>
</StackPane>

