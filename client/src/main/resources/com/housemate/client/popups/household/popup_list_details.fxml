<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.control.ScrollPane?>
<StackPane fx:id="popupListDetails" managed="false" visible="false" styleClass="popup-overlay" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.housemate.client.controllers.popups.household.PopupListDetailsController">
    <Region styleClass="popup-background" />
    <VBox maxHeight="500.0" maxWidth="350.0" spacing="15.0" styleClass="popup-container">
        <HBox alignment="CENTER_LEFT">
            <Label text="Shopping List Details" styleClass="popup-title"><font><Font name="System Bold" size="20.0" /></font></Label>
            <Region HBox.hgrow="ALWAYS" />
            <Button styleClass="popup-close-button" text="Back" onAction="#handleReturnToLists" />
            <Button styleClass="btn-popup-close" text="X" onAction="#handlePopupClosing" />
        </HBox>

        <ScrollPane fitToWidth="true" styleClass="transparent-scrollpane" VBox.vgrow="ALWAYS" hbarPolicy="NEVER">
            <VBox fx:id="listDetailsContainer" spacing="10.0" style="-fx-padding: 2;"/>
        </ScrollPane>

        <HBox alignment="CENTER_LEFT">
            <Button styleClass="btn-add-primary" text="Save Changes" onAction="#handleSaveChanges" />
        </HBox>
    </VBox>
</StackPane>

