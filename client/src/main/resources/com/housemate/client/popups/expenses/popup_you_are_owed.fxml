<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!-- Popup "You are Owed" -->
<StackPane fx:id="popupOverlayOwed" managed="false" visible="false" styleClass="popup-overlay" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.housemate.client.controllers.popups.expenses.PopupYouAreOwedController">
    <Region styleClass="popup-background" />
    <VBox maxHeight="500.0" maxWidth="350.0" spacing="15.0" styleClass="popup-container">
        <HBox alignment="CENTER_LEFT">
            <Label text="You are Owed" styleClass="popup-title"><font><Font name="System Bold" size="20.0" /></font></Label>
            <Region HBox.hgrow="ALWAYS" />

            <Button fx:id="btnClosePopupOwed" styleClass="popup-close-button" text="X" onAction="#handlePopupClosing" />
        </HBox>

        <ScrollPane fitToWidth="true" styleClass="transparent-scrollpane" VBox.vgrow="ALWAYS">
            <content>
                <VBox spacing="10.0" style="-fx-padding: 2;">

                    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="debt-item-owed">
                        <VBox HBox.hgrow="ALWAYS">
                            <Label text="Marco owes you" styleClass="debt-title-owed" />
                            <Label text="10 Mar 2026" styleClass="debt-date" />
                        </VBox>
                        <VBox alignment="CENTER_RIGHT" spacing="5.0">
                            <Label text="€ 22.00" styleClass="debt-amount-owed"><font><Font name="System Bold" size="14.0" /></font></Label>
                            <Button styleClass="settle-button-owed" text="Receive" />
                        </VBox>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="debt-item-owed">
                        <VBox HBox.hgrow="ALWAYS">
                            <Label text="Luca owes you" styleClass="debt-title-owed" />
                            <Label text="08 Mar 2026" styleClass="debt-date" />
                        </VBox>
                        <VBox alignment="CENTER_RIGHT" spacing="5.0">
                            <Label text="€ 18.30" styleClass="debt-amount-owed"><font><Font name="System Bold" size="14.0" /></font></Label>
                            <Button styleClass="settle-button-owed" text="Receive" />
                        </VBox>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="debt-item-owed">
                        <VBox HBox.hgrow="ALWAYS">
                            <Label text="Sofia owes you" styleClass="debt-title-owed" />
                            <Label text="04 Mar 2026" styleClass="debt-date" />
                        </VBox>
                        <VBox alignment="CENTER_RIGHT" spacing="5.0">
                            <Label text="€ 0.00" styleClass="debt-amount-owed"><font><Font name="System Bold" size="14.0" /></font></Label>
                            <Button styleClass="settle-button-owed" text="Receive" />
                        </VBox>
                    </HBox>

                </VBox>
            </content>
        </ScrollPane>
    </VBox>
</StackPane>

