<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="popupCreateAssignment" managed="false" visible="false" styleClass="popup-overlay" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.housemate.client.controllers.popups.assignments.PopupCreateAssignmentController">
    <Region styleClass="popup-background" />
    <VBox maxHeight="400.0" maxWidth="350.0" spacing="15.0" styleClass="popup-container">

        <HBox alignment="CENTER_LEFT">
            <Label text="Add Assignment" styleClass="popup-title"><font><Font name="System Bold" size="20.0" /></font></Label>
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#handlePopupClosing" styleClass="cancel-button" text="X" />
        </HBox>

        <VBox spacing="10.0" VBox.vgrow="ALWAYS">
            <Label text="Chore to assign:" styleClass="standard-label" />
            <ComboBox styleClass="custom-combo-box" fx:id="cmbChoreToAssign" maxWidth="Infinity" promptText="Select chore..." />

            <Label text="Assign to:" styleClass="standard-label" />
            <ComboBox styleClass="custom-combo-box" fx:id="cmbAssignUser" maxWidth="Infinity" promptText="Select user..." />

            <Label text = "Due date:" styleClass="standard-label" />
            <HBox spacing="10" alignment="CENTER_LEFT">
                <DatePicker styleClass="custom-date-picker" fx:id="dateDueDate" promptText="Select due date..." />
                <ComboBox styleClass="custom-combo-box, combo-box-compact" fx:id="cmbHour" promptText="H" prefWidth="80" />
                <Label text=":" styleClass="standard-label" />
                <ComboBox styleClass="custom-combo-box, combo-box-compact" fx:id="cmbMinute" promptText="M" prefWidth="80" />
            </HBox>
            <VBox alignment="CENTER">
                <Label fx:id="lblDatePassed" visible="false" text="Selected due date is not later than one hour from now" wrapText="true" styleClass="message-error"/>
            </VBox>
        </VBox>

        <HBox spacing="10.0">
            <Button maxWidth="Infinity" styleClass="standard-button" text="Create" onAction="#handleAssignmentCreation" />
            <Button maxWidth="Infinity" styleClass="cancel-button" text="Cancel" onAction="#handlePopupClosing"/>
        </HBox>

    </VBox>
</StackPane>

