<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.housemate.client.controllers.popups.PopupConfirmActionController"
           fx:id="popupConfirmAction"
           styleClass="popup-overlay">

    <VBox maxWidth="300" maxHeight="200" styleClass="popup-container" alignment="TOP_CENTER" spacing="20">
        <Label styleClass="popup-title" text = "Confirm Action"/>
        <Label styleClass="popup-label" fx:id="lblActionDesc" wrapText="true" />
        <Region VBox.vgrow="ALWAYS"/>
        <HBox alignment="BOTTOM_CENTER">
            <Button styleClass="btn-add-primary" text="Confirm" onAction="#handleConfirmAction"/>
            <Region maxWidth="100" HBox.hgrow="ALWAYS"/>
            <Button styleClass="btn-cancel" text="Cancel" onAction="#handlePopupClosing"/>
        </HBox>
    </VBox>

</StackPane>
