<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="popupCreateHousehold" managed="false" visible="false" styleClass="popup-overlay" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.housemate.client.controllers.popups.household.PopupCreateHouseholdController">
    <Region styleClass="popup-background" />
    <VBox maxHeight="500.0" maxWidth="380.0" spacing="15.0" styleClass="popup-container">
        <HBox alignment="CENTER_LEFT">
            <Label text="Create New Household" styleClass="popup-title"><font><Font name="System Bold" size="20.0" /></font></Label>
            <Region HBox.hgrow="ALWAYS" />
            <Button styleClass="cancel-button" text="X" onAction="#handlePopupClosing" />
        </HBox>

        <VBox spacing="5.0">
            <Label text="Name: " styleClass="standard-label" />
            <TextField styleClass="custom-text-field" fx:id="txtHouseholdName" maxWidth="Infinity" promptText="Household name..." />
        </VBox>

        <HBox spacing="10.0">
            <Button maxWidth="Infinity" styleClass="standard-button" text="Create" onAction="#handleHouseholdCreation"/>
            <Button maxWidth="Infinity" styleClass="cancel-button" text="Cancel" onAction="#handlePopupClosing"/>
        </HBox>
    </VBox>
</StackPane>
