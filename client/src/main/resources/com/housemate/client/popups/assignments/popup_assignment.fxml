<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="popupCreateAssignment" managed="false" visible="false" styleClass="popup-overlay" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.housemate.client.controllers.popups.assignments.PopupCreateAssignmentController">
    <Region styleClass="popup-background" />
    <VBox maxHeight="400.0" maxWidth="350.0" spacing="15.0" styleClass="popup-container">

        <HBox alignment="CENTER_LEFT">
            <Label text="Add Assignment" styleClass="popup-title"><font><Font name="System Bold" size="20.0" /></font></Label>
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#handlePopupClosing" styleClass="btn-popup-close" text="X" />
        </HBox>

        <VBox spacing="10.0" VBox.vgrow="ALWAYS">
            <Label text="Chore to assign:" styleClass="popup-label" />
            <ComboBox fx:id="cmbChoreToAssign" maxWidth="Infinity" promptText="Select chore..." />

            <Label text="Assign to:" styleClass="popup-label" />
            <ComboBox fx:id="cmbAssignUser" maxWidth="Infinity" promptText="Select user..." />

            <Label text = "Due date:" styleClass="popup-label" />
            <HBox spacing="10" alignment="CENTER_LEFT">
                <DatePicker fx:id="dateDueDate" promptText="Select due date..." />
                <ComboBox fx:id="cmbHour" promptText="HH" prefWidth="70" />
                <Label text=":" style="-fx-font-weight: bold;" />
                <ComboBox fx:id="cmbMinute" promptText="MM" prefWidth="70" />
            </HBox>
        </VBox>

        <HBox spacing="10.0">
            <Button maxWidth="Infinity" styleClass="btn-add-primary" text="Create" onAction="#handleAssignmentCreation" />
            <Button maxWidth="Infinity" styleClass="btn-cancel" text="Cancel" onAction="#handlePopupClosing"/>
        </HBox>

    </VBox>
</StackPane>

