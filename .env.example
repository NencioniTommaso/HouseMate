# HouseMate Environment Configuration Template
# Sole reference for non-secret environment variable names

# Database (Production PostgreSQL)
DB_USERNAME=housemate
DB_PASSWORD=your_production_password_here

# Application Security
APP_INVITE_CODE=your_invite_code_here
JWT_SECRET_KEY=your_base64_jwt_secret_key_minimum_256_bits_here

# Cloudflare Tunnel (Production)
TUNNEL_TOKEN=your_cloudflare_tunnel_token_here
