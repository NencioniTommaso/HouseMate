@startuml HouseMate_Client
' ── Compact settings for PDF page ──
skinparam dpi 150
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontSize 9
skinparam packageFontSize 10
skinparam packageFontStyle bold
skinparam classFontSize 9
skinparam classAttributeFontSize 8
skinparam nodesep 6
skinparam ranksep 10
skinparam padding 2
top to bottom direction

' ═══════════════════════════════════════════
'  APPLICATION ENTRY POINT
' ═══════════════════════════════════════════
package "application" #E3F2FD {
  class Launcher {
    + {static} main(args)
  }
  class HouseMateApplication {
    - httpClient : HttpClient
    - objectMapper : ObjectMapper
    - clientContext : SessionManager
    - services : AppServices
    --
    + start(stage)
    + showLoginScreen()
    + showMainScreen()
    + logout()
  }
  Launcher ..> HouseMateApplication : creates
}

' ═══════════════════════════════════════════
'  CONTEXT / SESSION
' ═══════════════════════════════════════════
package "context" #F3E5F5 {
  class AuthState {
    - jwt : String
    --
    + hasJwt() : boolean
    + clear()
  }
  class SessionManager {
    - authState : AuthState
    - currentUser : UserResponseDTO
    - currentHousehold : HouseholdResponseDTO
    - currentHouseholdMembers : List
  }
  class JwtPersistanceHandler {
    + {static} saveSession(token)
    + {static} getToken() : String
    + {static} clearSession()
  }
  SessionManager "1" o-- "1" AuthState
}

HouseMateApplication --> SessionManager
HouseMateApplication ..> JwtPersistanceHandler

' ═══════════════════════════════════════════
'  SERVICE LAYER
' ═══════════════════════════════════════════
package "service" #E8F5E9 {

  class ApiConfig {
    + {static} BASE_URL : String
  }

  class HttpRestClient {
    # httpClient : HttpClient
    # context : SessionManager
    # objectMapper : ObjectMapper
    --
    + serializeDTO(dto) : String
    + sendRequest(req) : HttpResponse
    + deserializeDTO(json, clazz) : T
    + deserializeDTOList(json, clazz) : List<T>
    + buildAuthHeader() : String
  }

  class AuthClientService {
    + login(dto) : UserResponseDTO
    + register(dto) : UserResponseDTO
  }
  class UserClientService {
    + getCurrentUser() : UserResponseDTO
    + updateUser(dto) : UserResponseDTO
    + deleteUser()
  }
  class HouseholdClientService {
    + getCurrentUserHousehold()
    + createHousehold(dto)
    + joinHousehold(dto)
    + leaveHousehold()
    + getMembers() : List
  }
  class ChoreClientService {
    + createChore(dto)
    + deleteChore(id)
    + createAssignment(dto)
    + updateStatus(id, dto)
    + getOverview()
    + getFilteredAssignments(filter)
  }
  class ShoppingListClientService {
    + createList(dto)
    + updateList(id, dto)
    + deleteList(id)
    + getLists()
  }
  class ExpenseClientService {
    + createExpense(dto)
    + deleteExpense(id)
    + getExpenses(filter)
    + getOverview()
  }
  class DebtClientService {
    + getUserDebts(filter)
    + getDebtOverview()
  }
  class SettlementClientService {
    + createSettlement(dto)
    + getSettlements(filter)
  }

  class AppServices {
    - sessionManager
    - authClientService
    - userClientService
    - householdClientService
    - choreClientService
    - shoppingListClientService
    - expenseClientService
    - settlementClientService
    - debtClientService
    --
    + AppServices(httpClient, mapper, session)
  }

  HttpRestClient --> SessionManager
  HttpRestClient ..> ApiConfig
  AuthClientService --> HttpRestClient
  UserClientService --> HttpRestClient
  HouseholdClientService --> HttpRestClient
  ChoreClientService --> HttpRestClient
  ShoppingListClientService --> HttpRestClient
  ExpenseClientService --> HttpRestClient
  DebtClientService --> HttpRestClient
  SettlementClientService --> HttpRestClient

  AppServices *-- AuthClientService
  AppServices *-- UserClientService
  AppServices *-- HouseholdClientService
  AppServices *-- ChoreClientService
  AppServices *-- ShoppingListClientService
  AppServices *-- ExpenseClientService
  AppServices *-- DebtClientService
  AppServices *-- SettlementClientService
  AppServices *-- HttpRestClient
  AppServices o-- SessionManager

  ' Force horizontal layout for services
  AuthClientService -[hidden]r- UserClientService
  UserClientService -[hidden]r- HouseholdClientService
  HouseholdClientService -[hidden]r- ChoreClientService
  
  ExpenseClientService -[hidden]r- DebtClientService
  DebtClientService -[hidden]r- SettlementClientService
  SettlementClientService -[hidden]r- ShoppingListClientService
  
  AuthClientService -[hidden]d- ExpenseClientService
}

HouseMateApplication *-- AppServices

' ═══════════════════════════════════════════
'  CONTROLLERS (JavaFX)
' ═══════════════════════════════════════════
package "controllers" #FCE4EC {

  class AuthScreenController {
    + initialize()
    + handleLogin()
    + handleRegister()
  }

  class MainController {
    - services : AppServices
    - logoutHandler : Runnable
    --
    + initialize()
    + openPopup(popup)
    + closePopup(popup)
    + showToast(msg, type)
    + requestConfirmForAction(msg, action)
  }

  class TabAssignmentsController {
    + initialize()
    + loadAssignments()
    + handleCreateAssignment()
    + handleStatusUpdate()
  }

  class TabExpensesController {
    + initialize()
    + loadExpenses()
    + loadDebts()
    + handleCreateExpense()
    + handleCreateSettlement()
  }

  class TabUserController {
    + initialize()
    + handleUpdateUser()
    + handleDeleteUser()
    + handleLogout()
  }

  class HouseholdTabWrapperController {
    + initialize()
    + showHouseholdView()
    + showNoHouseholdView()
  }

  class TabHouseholdController {
    + initialize()
    + loadHousehold()
    + handleLeaveHousehold()
    + handleShowMembers()
    + handleShoppingLists()
  }

  class TabNoHouseholdController {
    + initialize()
    + handleCreateHousehold()
    + handleJoinHousehold()
  }

  MainController *-- TabAssignmentsController
  MainController *-- TabExpensesController
  MainController *-- TabUserController
  MainController *-- HouseholdTabWrapperController
  HouseholdTabWrapperController *-- TabHouseholdController
  HouseholdTabWrapperController *-- TabNoHouseholdController

  ' Force horizontal layout for controllers
  TabAssignmentsController -[hidden]r- TabExpensesController
  TabExpensesController -[hidden]r- TabUserController
  
  HouseholdTabWrapperController -[hidden]r- TabHouseholdController
  TabHouseholdController -[hidden]r- TabNoHouseholdController
  
  TabAssignmentsController -[hidden]d- HouseholdTabWrapperController
}

' ═══════════════════════════════════════════
'  POPUPS
' ═══════════════════════════════════════════
package "popups" #FFF3E0 {
  class PopupConfirmActionController {
    + initialize()
    + handlePopupClosing()
    + handleConfirmAction()
  }
  class PopupCreateChoreController {
    + initialize()
    + handlePopupClosing()
    + handleChoreCreation()
    + handleReturnToChores()
  }
  class PopupCreateAssignmentController {
    + initialize()
    + handleAssignmentCreation()
    + handlePopupClosing()
    + fetchChoresData()
    + reloadMemberSelection()
  }
  class PopupCreateExpenseController {
    + initialize()
    + handlePopupClosing()
    + handleExpenseCreation()
    + loadMembers()
  }
  class PopupSettleDebtController {
    + initialize()
    + handlePopupClosing()
    + handleReturnToDebts()
    + handleDebtSettling()
    + handleLinkClick()
  }
  class PopupYouOweController {
    + handlePopupClosing()
    + fetchDebtsData()
  }
  class PopupYouAreOwedController {
    + handlePopupClosing()
    + fetchDebtsData()
  }
  class PopupCreateHouseholdController {
    + handlePopupClosing()
    + handleHouseholdCreation()
  }
  class PopupJoinHouseholdController {
    + handleJoinHousehold()
    + handlePopupClosing()
  }
  class PopupInviteMemberController {
    + initialize()
    + handleRefreshCode()
    + handlePopupClosing()
    + fetchInvitationCode()
    + setAdminMode(isAdmin)
  }
  class PopupManageMembersController {
    + handlePopupClosing()
    + fetchMembersData()
  }
  class PopupShoppingListsController {
    + handlePopupClosing()
    + handleOpenCreateList()
    + fetchListsData()
  }
  class PopupChangePasswordController

  ' Force horizontal grid for popups
  PopupConfirmActionController -[hidden]r- PopupCreateChoreController
  PopupCreateChoreController -[hidden]r- PopupCreateAssignmentController
  PopupCreateAssignmentController -[hidden]r- PopupCreateExpenseController
  
  PopupSettleDebtController -[hidden]r- PopupYouOweController
  PopupYouOweController -[hidden]r- PopupYouAreOwedController
  PopupYouAreOwedController -[hidden]r- PopupCreateHouseholdController
  
  PopupJoinHouseholdController -[hidden]r- PopupInviteMemberController
  PopupInviteMemberController -[hidden]r- PopupManageMembersController
  PopupManageMembersController -[hidden]r- PopupShoppingListsController
  
  PopupConfirmActionController -[hidden]d- PopupSettleDebtController
  PopupSettleDebtController -[hidden]d- PopupJoinHouseholdController
  PopupJoinHouseholdController -[hidden]d- PopupChangePasswordController
}

' ═══════════════════════════════════════════
'  UI COMPONENTS
' ═══════════════════════════════════════════
package "components" #FFF8E1 {
  class ChoreItemElement {
    + ChoreItemElement(chore, onChoreDeletion, isAdminMode)
  }
  class ExpenseItemElement {
    + ExpenseItemElement(dto, currentUserID)
  }
  class DebtItemElement {
    + DebtItemElement(debt, onOpenSettleDebt)
  }
  class SettlementItemElement {
    + SettlementItemElement(dto)
  }
  class MemberItemElement {
    + MemberItemElement(member, onUserRemoval, isAdminMode, currentUserId, onLinkError)
  }
  class MemberSplitBox {
    - member : UserResponseDTO
    --
    + MemberSplitBox(member, mode)
    + setSplitMode(mode)
    + toExpenseShare() : ExpenseShareRequestDTO
    + updateShareAmount(amount)
    + setExactAmount()
    + getShareCount() : int
    + isIncluded() : boolean
    + getAdjustmentAmount() : BigDecimal
  }

  ' Force horizontal grid for components
  ChoreItemElement -[hidden]r- ExpenseItemElement
  ExpenseItemElement -[hidden]r- DebtItemElement
  
  SettlementItemElement -[hidden]r- MemberItemElement
  MemberItemElement -[hidden]r- MemberSplitBox
  
  ChoreItemElement -[hidden]d- SettlementItemElement
}

' ═══════════════════════════════════════════
'  WIRING
' ═══════════════════════════════════════════
HouseMateApplication ..> AuthScreenController : creates
HouseMateApplication ..> MainController : creates
AuthScreenController --> AppServices
MainController --> AppServices

' Force a single column layout underneath controllers to prevent vertical stretching
controllers -[hidden]r-> application
application -[hidden]r-> components
controllers -[hidden]d-> service
service -[hidden]d-> context
context -[hidden]d-> popups

@enduml
