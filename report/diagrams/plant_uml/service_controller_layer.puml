@startuml
skinparam classAttributeIconSize 0
skinparam monochrome true
skinparam packageStyle rectangle
skinparam nodesep 60
skinparam ranksep 60
skinparam linetype ortho

' --- CONTROLLERS ---
class AuthController <<controller>> {
  POST /login
  POST /register
}

class UserController <<controller>> {
  GET /me
  PATCH /me
}

class HouseholdController <<controller>> {
  POST /
  POST /members
  DELETE /members/{memberId}
  GET /me
  DELETE /me
  GET /invitation-code
  POST /invitation-code/refresh
  GET /members
}

class ExpenseController <<controller>> {
  POST /
  GET /
  GET /overview
  GET /me
}

class ChoreController <<controller>> {
  POST /
  DELETE /{choreId}
  GET /
  POST /assignments
  DELETE /assignments/{assignmentId}
  PATCH /assignments/{assignmentId}/status
  PATCH /assignments/{assignmentId}/reassign
  GET /assignments
  GET /assignments/overview
  GET /assignments/me
}

class DebtController <<controller>> {
  GET /
  GET /me
  DELETE /{debtId}
}

class SettlementController <<controller>> {
  POST /{debtId}
  GET /
}

class ShoppingListController <<controller>> {
  POST /
  PATCH /{listId}
  DELETE /{listId}
  GET /
}

' --- SERVICES ---
class AuthService {
  + login(dto)
  + register(dto)
}

class UserService {
  + loadUserByUsername(email)
  + loadUserById(id)
  + getCurrentUser(userId)
  + updateCurrentUser(userId, dto)
}

class HouseholdService {
  + createHousehold(userId, dto)
  + getCurrentUserHousehold(userId)
  + getHouseholdMembers(requesterUserId)
  + addMember(requesterUserId, dto)
  + removeMember(requesterUserId, memberId)
  + leaveHousehold(userId)
  + getInvitationCode(userId)
  + refreshInvitationCode(requesterUserId)
}

class ExpenseService {
  + createExpense(...)
  + getFilteredExpenses(userId, filter)
  + getCurrentMonthExpenseOverview(userId)
  + getCurrentMonthUserNetOverview(userId)
}

class ChoreService {
  + createChore(userId, dto)
  + deleteChore(choreId, userId)
  + getAllHouseholdChores(userId)
  + deleteAllChoresForHousehold(userId)
  + createChoreAssignment(userId, dto)
  + deleteChoreAssignment(...)
  + updateChoreAssignmentStatus(...)
  + reassignChore(...)
  + getAssignmentOverview(userId)
  + getUserAssignmentOverview(userId)
  + getFilteredChoreAssignments(...)
  + checkAndMarkOverdueAssignments()
}

class DebtService {
  + addDebt(...)
  + deleteDebt(debtId)
  + getFilteredDebts(...)
  + getCurrentUserDebtOverview(userId)
}

class SettlementService {
  + settleDebt(...)
  + getFilteredSettlements(...)
}

class ShoppingListService {
  + createShoppingList(userId, dto)
  + updateShoppingList(...)
  + deleteShoppingList(userId, listId)
  + getShoppingListsByHousehold(userId)
}

' --- RELATIONSHIPS ---

AuthController .down.> AuthService : uses >
UserController .down.> UserService : uses >
HouseholdController .down.> HouseholdService : uses >
ExpenseController .down.> ExpenseService : uses >
ChoreController .down.> ChoreService : uses >
DebtController .down.> DebtService : uses >
SettlementController .down.> SettlementService : uses >
ShoppingListController .down.> ShoppingListService : uses >

' Cross-service dependencies
AuthService .down.> UserService : delegates >
ExpenseService .down.> DebtService : delegates >

' Layout arrangement
AuthController -right[hidden]- UserController
UserController -right[hidden]- HouseholdController
HouseholdController -right[hidden]- ExpenseController
ExpenseController -right[hidden]- ChoreController

DebtController -right[hidden]- SettlementController
SettlementController -right[hidden]- ShoppingListController

HouseholdService -down[hidden]- DebtController
ChoreService -down[hidden]- SettlementController

@enduml
